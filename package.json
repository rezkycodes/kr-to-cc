{
  "name": "kiro-to-claude",
  "version": "1.0.0",
  "description": "Proxy server to use Kiro's Claude models with Claude Code CLI",
  "main": "apps/server/src/index.js",
  "type": "module",
  "bin": {
    "kiro-to-claude": "bin/cli.js"
  },
  "files": [
    "apps/server/src",
    "bin",
    "dist/apps/web",
    "README.md",
    "DOCUMENTATION.md",
    "COMMANDS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "nx build web",
    "start": "node apps/server/src/index.js",
    "start:server": "node apps/server/src/index.js",
    "dev": "nx run-many -t dev --projects=server,web --parallel=2",
    "dev:web": "nx dev web",
    "dev:server": "PORT=4985 HOST=127.0.0.1 node --watch apps/server/src/index.js",
    "test": "nx build web && nx run-many -t test --projects=server,web --parallel=2",
    "test:server": "node --test apps/server/test/*.test.js",
    "typecheck": "nx typecheck web",
    "check": "nx run server:check",
    "prepack": "nx build web"
  },
  "keywords": [
    "claude",
    "anthropic",
    "kiro",
    "proxy",
    "aws",
    "codewhisperer",
    "ai",
    "llm"
  ],
  "author": "rezkycodes",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rezkycodes/kr-to-cc.git"
  },
  "homepage": "https://github.com/rezkycodes/kr-to-cc#readme",
  "bugs": {
    "url": "https://github.com/rezkycodes/kr-to-cc/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.5.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "node-forge": "^1.4.0",
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@lucide/vue": "1.28.0",
    "@nx/js": "23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/vitest": "23.1.1",
    "@nx/vue": "23.1.1",
    "@nx/web": "23.1.1",
    "@swc/helpers": "0.5.23",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "2.4.11",
    "@vueuse/core": "14.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "happy-dom": "20.11.1",
    "jiti": "2.4.2",
    "nx": "23.1.1",
    "prettier": "3.6.2",
    "reka-ui": "2.10.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tslib": "2.8.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "vue-router": "4.6.4",
    "vue-tsc": "2.2.12"
  },
  "nx": {}
}
